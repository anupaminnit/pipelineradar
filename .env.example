# PipelineRadar — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- openFDA (optional — raises daily rate limit) ---
# OPENFDA_API_KEY=your-openfda-key

# --- Email / SMTP delivery (optional — required for Phase 4) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=pipelineradar@example.com
# EMAIL_TO=you@example.com
# ALERT_TO_EMAIL=you@example.com   # recipient for intelligence briefs

# --- App ---
LOG_LEVEL=INFO
